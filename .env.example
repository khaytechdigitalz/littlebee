NODE_ENV=development
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info
APP_NAME=littlebee
APP_KEY=

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=littlebee
DB_PASSWORD=
DB_DATABASE=littlebee

# JWT / session
ACCESS_TOKEN_EXPIRY=1d

# Coinremitter — one API key/password pair per active coin wallet
COINREMITTER_BTC_API_KEY=
COINREMITTER_BTC_PASSWORD=
COINREMITTER_ETH_API_KEY=
COINREMITTER_ETH_PASSWORD=
COINREMITTER_USDT_API_KEY=
COINREMITTER_USDT_PASSWORD=
COINREMITTER_LTC_API_KEY=
COINREMITTER_LTC_PASSWORD=
COINREMITTER_DOGE_API_KEY=
COINREMITTER_DOGE_PASSWORD=
COINREMITTER_BNB_API_KEY=
COINREMITTER_BNB_PASSWORD=
COINREMITTER_WEBHOOK_URL=https://yourdomain.com/api/webhooks/coinremitter
COINREMITTER_MIN_CONFIRMATIONS=2

# Live price feed (used to fill and mark-to-market real trades — see app/services/price_feed_service.ts)
PRICE_FEED_BASE_URL=https://api.coingecko.com/api/v3
STOCKS_FX_FEED_BASE_URL=https://api.twelvedata.com
STOCKS_FX_API_KEY=

# Admin
DEFAULT_ADMIN_EMAIL=admin@littlebee.io
DEFAULT_ADMIN_PASSWORD=

# --- Frontend (Vite) ---
# Not needed in normal use: this is a monolith, so the frontend calls the
# API same-origin (relative "/api/v1") automatically in both dev (via the
# Vite proxy in vite.config.ts) and production (single server, single
# port). Only set this if you're building the frontend to point at a
# *different* deployed API host than the one serving it.
# VITE_API_BASE_URL=
